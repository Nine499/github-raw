{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.baidu.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/github-raw.js?path=:path*"
    }
  ]
}
